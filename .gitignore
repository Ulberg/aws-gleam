*.beam
*.ez
/build
erl_crash.dump

codegen/build

.tools/smithy-cli-darwin-aarch64/
.tools/smithy-cli.zip
.tools/build

# Derived files regenerated by `./scripts/regen.sh` from sources
# that ARE in git (`vendor/aws-sdk-rust/aws-models/*.json` and
# `vendor/smithy/...`). Kept out of git so the diff stays focused
# on hand-written code (~135 kLOC saved between services, endpoint
# fixtures, and protocol-test ASTs).

# Generated protocol-test surrogate clients (still under the root
# meta-package because the protocol-test runner needs them all in
# one place).
/src/aws/services/

# Per-service hex packages live under services/<svc>/. Only the
# services the root meta-package + the publish list actively
# reference have their gleam.toml / README / LICENSE tracked
# (committed by hand on first use, or via the regen
# ensure_service_package helper). The other ~410 services get
# their skeletons regenerated on demand and stay out of git.
/services/*
!/services/CLAUDE.md
!/services/api_gateway/
!/services/cloudwatch_logs/
!/services/dynamodb/
!/services/eks/
!/services/rds/
!/services/s3/
!/services/sesv2/
!/services/sqs/
!/services/transcribe_streaming/

# Inside each tracked service: gleam.toml + LICENSE + README are
# committed, but generated source + build cache + manifest are
# regenerated and stay out of git.
/services/*/src/aws/services/
/services/*/build/
/services/*/manifest.toml

# Endpoint rule-set + tests, extracted per-service from the
# `smithy.rules#endpointRuleSet` / `endpointTests` traits inside
# `vendor/aws-sdk-rust/aws-models/*.json` by
# `./scripts/extract-endpoints.sh`.
/test/fixtures/endpoints/

# Smithy AST output for the protocol-test models, produced by
# `./scripts/build-protocol-test-asts.sh` (requires the Smithy CLI
# under `.tools/`).
/test/fixtures/protocol-tests/

# Protocol-test dispatcher modules STAY in git for now: the
# Python generator regex-scrapes the just-emitted Gleam service
# modules, and not every restXml op has a green codec, so the
# committed dispatchers are a curated subset. Pass 2 of plan.md
# moves dispatcher generation into the Gleam emitter and unblocks
# evicting these from the index too.
